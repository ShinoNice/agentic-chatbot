# ─── LLM API Keys ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Vector Database ─────────────────────────────────────────────────────────
# Leave PINECONE_API_KEY empty to fall back to local ChromaDB
PINECONE_API_KEY=your-pinecone-api-key-here

# ─── Application Settings ─────────────────────────────────────────────────────
PYTHONPATH=.
ENV=development
DEBUG=true

# Comma-separated list of allowed CORS origins. When set, this OVERRIDES the
# `app.cors_origins` list in config/settings.yaml. Use this in production to
# inject the deployed frontend FQDN without baking it into committed config.
# Example:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# ─── LangSmith Observability (optional) ──────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT="Agentic_Chatbot"
