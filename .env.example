# ─── LLM API Keys ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Vector Database ─────────────────────────────────────────────────────────
# Leave PINECONE_API_KEY empty to fall back to local ChromaDB
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=agentic-chatbot

# ─── Tools & Internet Search ─────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-key-here

# ─── Application Settings ─────────────────────────────────────────────────────
PYTHONPATH=.
ENV=development
DEBUG=true

# ─── LangSmith Observability ──────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
LANGSMITH_PROJECT="Agentic_Chatbot"

# ─── Push Notifications (Pushover) ───────────────────────────────────────────
PUSHOVER_USER=your-pushover-user-key-here
PUSHOVER_TOKEN=your-pushover-app-token-here
